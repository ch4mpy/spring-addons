<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>com.c4-soft.springaddons</groupId>
		<artifactId>spring-addons</artifactId>
		<version>9.7.2-SNAPSHOT</version>
		<relativePath>..</relativePath>
	</parent>
	<groupId>com.c4-soft.springaddons.samples</groupId>
	<artifactId>spring-addons-samples</artifactId>
	<packaging>pom</packaging>
	<description>Runnable samples for spring-addons starters and test annotations. Each module is a Spring Boot application with its own README.</description>

	<properties>
		<java.version>17</java.version>
		<spring-cloud.version>2025.1.4</spring-cloud.version>
	</properties>

	<modules>
		<module>resource-server</module>
		<module>resource-server-reactive</module>
		<module>bff</module>
		<module>rest-client</module>
		<module>client-and-resource-server</module>
	</modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<profiles>
		<profile>
			<id>aot</id>
			<properties>
				<!-- Spring Cloud's refresh scope is not compatible with AOT -->
				<spring.cloud.refresh.enabled>false</spring.cloud.refresh.enabled>
			</properties>
			<build>
				<pluginManagement>
					<plugins>
						<plugin>
							<groupId>org.springframework.boot</groupId>
							<artifactId>spring-boot-maven-plugin</artifactId>
							<configuration>
								<systemPropertyVariables>
									<spring.cloud.refresh.enabled>${spring.cloud.refresh.enabled}</spring.cloud.refresh.enabled>
								</systemPropertyVariables>
							</configuration>
							<executions>
								<execution>
									<id>process-aot</id>
									<goals>
										<goal>process-aot</goal>
									</goals>
								</execution>
								<execution>
									<id>process-test-aot</id>
									<goals>
										<goal>process-test-aot</goal>
									</goals>
								</execution>
							</executions>
						</plugin>
						<plugin>
							<groupId>org.apache.maven.plugins</groupId>
							<artifactId>maven-surefire-plugin</artifactId>
							<configuration>
								<systemPropertyVariables>
									<spring.aot.enabled>true</spring.aot.enabled>
									<spring.cloud.refresh.enabled>${spring.cloud.refresh.enabled}</spring.cloud.refresh.enabled>
								</systemPropertyVariables>
							</configuration>
						</plugin>
					</plugins>
				</pluginManagement>
			</build>
		</profile>
	</profiles>

</project>
